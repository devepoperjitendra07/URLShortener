# Copy to `.env` and adjust for your environment. Do NOT commit `.env`.
# The application reads these; the committed defaults are for local dev only.

# ─── Server ───
SERVER_PORT=8082
# Public base used to build short links (scheme://host:port/api)
APP_BASE_URL=http://localhost:8082/api

# ─── Database (Postgres) ───
DB_URL=jdbc:postgresql://localhost:5432/urlshortener
DB_USERNAME=adda247
DB_PASSWORD=secret

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT (HS256, key must be >= 32 bytes) ───
# Generate a strong one, e.g.:  openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-min-32-bytes
JWT_EXPIRY_MS=86400000

# ─── CORS (comma-separated allowed browser origins) ───
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000